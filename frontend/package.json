{
  "name": "volley-control-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:types": "openapi-typescript ./schema/openapi.json -o ./src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0 && npm run lint:overlays",
    "lint:overlays": "cd .. && frontend/node_modules/.bin/eslint --config frontend/eslint.config.js overlay_static/js --max-warnings 0",
    "lint:fix": "eslint src --fix && npm run lint:overlays -- --fix",
    "stylelint": "stylelint \"../overlay_static/css/**/*.css\" --max-warnings 0",
    "stylelint:fix": "npm run stylelint -- --fix",
    "format": "prettier --write src ../overlay_static/js ../overlay_static/css",
    "format:check": "prettier --check src ../overlay_static/js ../overlay_static/css"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "material-icons": "^1.13.14",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.2.0",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "js-yaml": "^4.3.1",
    "minimatch@10": {
      "brace-expansion": "^5.0.8"
    }
  }
}
